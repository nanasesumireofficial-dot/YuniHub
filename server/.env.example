# Set these as Railway service variables. Never commit real secret values.
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-application-client-secret
DISCORD_REDIRECT_URI=https://your-railway-domain.up.railway.app/auth/discord/callback
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
YUNIHUB_REDIRECT_URI=yunihub://discord-auth
NODE_ENV=production
