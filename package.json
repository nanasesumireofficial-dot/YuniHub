{
  "name": "yuni-hub",
  "productName": "YuniHub",
  "version": "0.4.0",
  "description": "A premium desktop hub for launching and tracking your projects.",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "build:renderer": "esbuild renderer/app.js renderer/script-preview.js --bundle --minify --platform=browser --format=esm --splitting --target=chrome130 --outdir=renderer/generated",
    "test": "node --test",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:dir": "npm run build:renderer && electron-builder --dir",
    "release": "npm run build:renderer && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.yunihub.app",
    "productName": "YuniHub",
    "publish": [{ "provider": "github", "owner": "nanasesumireofficial-dot", "repo": "YuniHub" }],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "yuniku-scripts/**/*",
      "build/icon.png",
      "build/yunihub-icon.svg",
      "yunihub-logo-wordmark.svg",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0"
  }
}
